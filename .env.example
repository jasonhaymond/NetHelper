# NetHelper settings - EXAMPLE (copy to your .env; see 'nethelper help settings')
#
# One KEY=VALUE per line. Edit with 'nethelper config' or any text editor.
# Empty value = built-in default/automatic. Command-line flags override these.


# --- General -----------------------------------------------------
# Default site profile (.toml) used when --profile isn't given (default: empty)
NETHELPER_PROFILE=
# Per-probe network timeout in seconds (default: 3)
NETHELPER_TIMEOUT=3
# Pings per latency test (default: 10)
NETHELPER_PING_COUNT=10
# Default interface(s): comma list, 'all', or empty for automatic (default: empty)
NETHELPER_INTERFACES=
# Allow third-party lookups (public IP, internet speed test) (default: true)
NETHELPER_EXTERNAL_LOOKUPS=true
# Coloured output: auto, always or never (default: auto)
NETHELPER_COLOR=auto
# Hide checks that need elevation instead of listing them (default: false)
NETHELPER_HIDE_LIMITED=false
# Seconds to listen for LLDP/CDP (65 for CDP-only switches) (default: 35)
NETHELPER_SWITCHPORT_WAIT=35

# --- Logging -----------------------------------------------------
# Detail level written to each run's log file (default: debug)
NETHELPER_LOG_LEVEL=debug
# Number of run logs to keep (oldest deleted first) (default: 40)
NETHELPER_LOG_KEEP=40
# Folder for run logs (empty = <data dir>/logs) (default: empty)
NETHELPER_LOG_DIR=

# --- Folders -----------------------------------------------------
# Folder where menu-generated reports are saved (empty = current folder) (default: empty)
NETHELPER_REPORT_DIR=
# Folder for packet captures (empty = <data dir>/captures) (default: empty)
NETHELPER_CAPTURE_DIR=

# --- Speed test --------------------------------------------------
# Download test URL ({bytes} is replaced with the size) (default: https://speed.cloudflare.com/__down?bytes={bytes})
NETHELPER_SPEEDTEST_DOWNLOAD_URL=https://speed.cloudflare.com/__down?bytes={bytes}
# Upload test URL (receives a POST) (default: https://speed.cloudflare.com/__up)
NETHELPER_SPEEDTEST_UPLOAD_URL=https://speed.cloudflare.com/__up
# Bytes to download in the speed test (default: 25000000)
NETHELPER_SPEEDTEST_DOWNLOAD_BYTES=25000000
# Bytes to upload in the speed test (default: 5000000)
NETHELPER_SPEEDTEST_UPLOAD_BYTES=5000000
# Public IP / ISP lookup service (default: https://ipinfo.io/json)
NETHELPER_PUBLIC_IP_URL=https://ipinfo.io/json

# --- Throughput --------------------------------------------------
# Default throughput target for full runs: a host, 'gateway', or empty to skip (default: empty)
NETHELPER_THROUGHPUT_TARGET=
# TCP/UDP port for 'nethelper serve' / 'throughput' (default: 5202)
NETHELPER_THROUGHPUT_PORT=5202
# Seconds per throughput test direction (default: 10)
NETHELPER_THROUGHPUT_SECONDS=10
# Parallel TCP streams per throughput test (default: 1)
NETHELPER_THROUGHPUT_STREAMS=1
# Shared secret required by 'nethelper serve' (empty = no key) [SECRET] (default: empty)
NETHELPER_THROUGHPUT_KEY=
# Port of iperf3 servers (used as a fallback) (default: 5201)
NETHELPER_IPERF_PORT=5201

# --- Output destinations -----------------------------------------
# Where to copy outputs after each run, separated by ';' - folder, \\server\share, smb://, sftp://, webdavs://, https://, ftps://, s3://, mailto:, syslog+tls:// (empty = keep local only) (default: empty)
NETHELPER_OUTPUT_DESTINATIONS=
# Which outputs to copy: any of reports, captures, logs, results (default: reports,captures,logs,results)
NETHELPER_OUTPUT_INCLUDE=reports,captures,logs,results
# Sub-folder at each destination ({host}, {date}, {user} are filled in) (default: {host}/{date})
NETHELPER_OUTPUT_SUBDIR={host}/{date}
# Always save each diagnostic's results as JSON in the results folder (default: false)
NETHELPER_SAVE_RESULTS=false
# Folder for saved results JSON (empty = <data dir>/results) (default: empty)
NETHELPER_RESULTS_DIR=
# Password / app password for WebDAV, HTTPS (Basic), FTPS or SMB (smbclient) destinations [SECRET] (default: empty)
NETHELPER_DEST_PASSWORD=
# Bearer token for HTTPS upload destinations [SECRET] (default: empty)
NETHELPER_DEST_TOKEN=
# HTTP method for https:// destinations (default: put)
NETHELPER_HTTP_UPLOAD_METHOD=put
# SSH private key for sftp:// / scp:// (empty = ssh-agent/default keys) (default: empty)
NETHELPER_SSH_KEY=
# Trust an SSH server's host key on first connection (otherwise it must already be in known_hosts) (default: false)
NETHELPER_SSH_ACCEPT_NEW_HOSTKEYS=false
# known_hosts file for sftp:// destinations (empty = your normal ~/.ssh/known_hosts) (default: empty)
NETHELPER_SSH_KNOWN_HOSTS=
# Allow unencrypted destinations: http://, webdav://, ftp://, syslog:// (UDP), syslog+tcp://, an http:// S3 endpoint, SMTP security 'none' (not recommended) (default: false)
NETHELPER_DEST_ALLOW_INSECURE=false
# Extra CA certificate file (PEM) trusted for destinations that use an internal/company CA (default: empty)
NETHELPER_DEST_CA_FILE=

# --- S3 storage --------------------------------------------------
# S3 service URL (empty = AWS; e.g. https://minio.example.com:9000, https://s3.us-west-004.backblazeb2.com) (default: empty)
NETHELPER_S3_ENDPOINT=
# S3 region of the bucket (MinIO: usually us-east-1) (default: us-east-1)
NETHELPER_S3_REGION=us-east-1
# S3 access key ID (empty = AWS_ACCESS_KEY_ID environment variable) (default: empty)
NETHELPER_S3_ACCESS_KEY=
# S3 secret access key (empty = AWS_SECRET_ACCESS_KEY environment variable) [SECRET] (default: empty)
NETHELPER_S3_SECRET_KEY=
# Bucket addressing: auto (virtual-host for AWS, path for others), path or virtual (default: auto)
NETHELPER_S3_ADDRESSING=auto

# --- Email -------------------------------------------------------
# SMTP server for mailto: destinations, optionally with :port (e.g. smtp.office365.com) (default: empty)
NETHELPER_SMTP_SERVER=
# starttls (port 587), ssl (port 465) or none (port 25, needs NETHELPER_DEST_ALLOW_INSECURE) (default: starttls)
NETHELPER_SMTP_SECURITY=starttls
# SMTP login name (empty = send without logging in, e.g. an internal relay) (default: empty)
NETHELPER_SMTP_USER=
# SMTP password / app password [SECRET] (default: empty)
NETHELPER_SMTP_PASSWORD=
# Sender address (empty = the SMTP login if it is an address, else nethelper@<computer name>) (default: empty)
NETHELPER_SMTP_FROM=
# Largest total attachment size per email in MB; bigger files are listed but not attached (default: 20)
NETHELPER_EMAIL_MAX_MB=20

# --- Syslog ------------------------------------------------------
# Syslog facility for events sent to syslog destinations (default: local0)
NETHELPER_SYSLOG_FACILITY=local0
# rfc5424 (key=value structured data) or json (message body is a JSON object) (default: rfc5424)
NETHELPER_SYSLOG_FORMAT=rfc5424
